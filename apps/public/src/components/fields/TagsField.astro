---
interface Props {
  value: unknown;
  class?: string;
}

const { value, class: className = '' } = Astro.props;

let tags: string[] = [];

if (Array.isArray(value)) {
  tags = value.map((item) => String(item).trim()).filter(Boolean);
} else if (typeof value === 'string' && value.trim()) {
  tags = value.split(',').map((t) => t.trim()).filter(Boolean);
}
---

{tags.length > 0 ? (
  <div class={`tags ${className}`}>
    {tags.map((tag) => (
      <span class="tag">
        {tag}
      </span>
    ))}
  </div>
) : null}
