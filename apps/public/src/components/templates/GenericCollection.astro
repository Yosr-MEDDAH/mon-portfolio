---
import type {
  ContentTypeDefinition,
  ContentEntry,
  SupportedLocale,
} from '../../content-model/types.ts';
import type { CardTemplateConfig } from '../../templates/types.ts';
import GenericCard from '../cards/GenericCard.astro';
import { resolveLocalizedValue } from '../../utils/url.ts';
import { t } from '../../i18n/utils.ts';
import { DEFAULT_LOCALE } from '../../i18n/types.ts';

interface Props {
  contentType: ContentTypeDefinition;
  entries: ContentEntry[];
  cardTemplate?: CardTemplateConfig;
  locale?: SupportedLocale;
  title?: string;
  description?: string;
}

const {
  contentType,
  entries,
  cardTemplate,
  locale = DEFAULT_LOCALE,
  title = resolveLocalizedValue(contentType.name, locale),
  description = resolveLocalizedValue(contentType.description, locale),
} = Astro.props;
---

<div class="container page-header">
  <p class="section-label">{title}</p>
  <h1 class="page-title" id="page-title">{title}</h1>
  {description && (
    <p class="page-count" style="max-width: 65ch; line-height: 1.6;">
      {description}
    </p>
  )}
</div>

<section aria-labelledby="page-title" style="padding-top:0">
  <div class="container">
    {entries.length > 0 ? (
      <div class="projects-grid" role="list">
        {entries.map((entry) => (
          <GenericCard
            contentType={contentType}
            entry={entry}
            template={cardTemplate}
            locale={locale}
          />
        ))}
      </div>
    ) : (
      <div style="padding: 2rem 0; color: var(--text-3);">
        <p>{t('ui.emptyCollection', locale)}</p>
      </div>
    )}
  </div>
</section>
