---
import type {
  ContentTypeDefinition,
  ContentEntry,
  SupportedLocale,
} from '../../content-model/types.ts';
import type { CardTemplateConfig } from '../../templates/types.ts';
import { isFieldVisible } from '../../content-model/visibility.ts';
import { withBase, resolveLocalizedValue } from '../../utils/url.ts';
import { DEFAULT_LOCALE } from '../../i18n/types.ts';
import { DEVICON_MAP, getProjGrad, getProjEmoji } from '../../data/portfolio.ts';

interface Props {
  contentType: ContentTypeDefinition;
  entry: ContentEntry;
  template?: CardTemplateConfig;
  locale?: SupportedLocale;
  class?: string;
}

const {
  contentType,
  entry,
  template,
  locale = DEFAULT_LOCALE,
  class: className = '',
} = Astro.props;

const fields = entry.fields || {};
const title = resolveLocalizedValue(fields.title, locale) || entry.slug;
const desc = resolveLocalizedValue(fields.description, locale) || '';
const context = fields.context ? resolveLocalizedValue(fields.context, locale) : '';
const tags: string[] = Array.isArray(fields.tags) ? fields.tags : (fields.technologies ? (Array.isArray(fields.technologies) ? fields.technologies : [fields.technologies]) : []);

const coverImage = fields.coverImage || '';
const hasRealImage = coverImage && coverImage !== 'placeholder.png' && coverImage.trim() !== '';

const imageSrc = hasRealImage
  ? (coverImage.startsWith('http') ? coverImage : withBase(`/${coverImage.replace(/^\//, '')}`))
  : '';

const isVideo = hasRealImage && coverImage.endsWith('.mp4');

const detailHref = locale === DEFAULT_LOCALE
  ? withBase(`/${contentType.slug}/${entry.slug}.html`)
  : withBase(`/${locale}/${contentType.slug}/${entry.slug}.html`);

const gradStyle = `background: linear-gradient(135deg, ${getProjGrad(tags)});`;
const emoji = getProjEmoji(tags);
---

<article class={`proj-card reveal visible ${className}`} role="listitem">
  <div class="proj-media">
    {hasRealImage ? (
      isVideo ? (
        <video
          src={imageSrc}
          autoplay
          loop
          muted
          playsinline
          style="width:100%; height:100%; object-fit:cover;"
        />
      ) : (
        <img
          src={imageSrc}
          alt={title}
          loading="lazy"
          decoding="async"
          onload="this.classList.add('loaded'); this.parentElement?.classList.add('loaded');"
          class="loaded"
        />
      )
    ) : (
      <div class="proj-media-bg" style={gradStyle}>
        <span class="proj-media-emoji" aria-hidden="true">{emoji}</span>
      </div>
    )}
  </div>

  <div class="proj-body">
    <p class="proj-title">
      <a href={detailHref} style="color:inherit; text-decoration:none;">{title}</a>
    </p>
    {context && <p class="proj-context">{context}</p>}
    <p class="proj-desc">{desc}</p>

    {tags.length > 0 && (
      <div class="tags">
        {tags.map((tag) => {
          const devicon = DEVICON_MAP[tag];
          return (
            <span class="tag">
              {devicon && (
                <i
                  class={`devicon-${devicon} colored tag-icon`}
                  aria-hidden="true"
                />
              )}
              {tag}
            </span>
          );
        })}
      </div>
    )}

    {fields.externalLink && (
      <div class="proj-actions">
        <a
          href={fields.externalLink}
          target="_blank"
          rel="noopener"
          class="proj-btn"
          aria-label={`${title} — Lien`}
        >
          ↗ Lien
        </a>
      </div>
    )}
  </div>
</article>
