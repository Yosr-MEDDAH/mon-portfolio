---
import { resolveLocalizedValue } from '../../utils/url.ts';
import type { SupportedLocale } from '../../content-model/types.ts';

interface Props {
  value: unknown;
  type?: 'text' | 'textarea';
  locale?: SupportedLocale;
  as?: 'h1' | 'h2' | 'h3' | 'h4' | 'p' | 'span' | 'div';
  class?: string;
}

const {
  value,
  type = 'text',
  locale = 'fr',
  as: Component = type === 'textarea' ? 'p' : 'span',
  class: className = '',
} = Astro.props;

const displayValue = resolveLocalizedValue(value, locale);

function inlineMd(s: string): string {
  return s
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.+?)\*/g, '<em>$1</em>')
    .replace(/`(.+?)`/g, '<code>$1</code>');
}

function renderMarkdown(src: string): string {
  const lines = src.split(/\r?\n/);
  const out: string[] = [];
  let inList = false;
  let para: string[] = [];
  const flushPara = () => {
    if (para.length) {
      out.push(`<p>${inlineMd(para.join(' '))}</p>`);
      para = [];
    }
  };
  const flushList = () => {
    if (inList) {
      out.push('</ul>');
      inList = false;
    }
  };
  for (const raw of lines) {
    const line = raw.trim();
    if (line === '') {
      flushPara();
      flushList();
      continue;
    }
    const h = line.match(/^(#{1,6})\s+(.*)$/);
    if (h) {
      flushPara();
      flushList();
      const level = h[1].length;
      out.push(`<h${level}>${inlineMd(h[2])}</h${level}>`);
      continue;
    }
    const li = line.match(/^[-*]\s+(.*)$/);
    if (li) {
      flushPara();
      if (!inList) {
        out.push('<ul>');
        inList = true;
      }
      out.push(`<li>${inlineMd(li[1])}</li>`);
      continue;
    }
    para.push(line);
  }
  flushPara();
  flushList();
  return out.join('\n');
}

const renderedHtml = type === 'textarea' && displayValue ? renderMarkdown(displayValue) : null;
---

{displayValue ? (
  renderedHtml ? (
    <div class={`field-text field-textarea ${className}`} set:html={renderedHtml} />
  ) : (
    <Component class={`field-text ${type === 'textarea' ? 'field-textarea whitespace-pre-line' : ''} ${className}`}>
      {displayValue}
    </Component>
  )
) : null}
---
