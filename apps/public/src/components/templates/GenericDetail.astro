---
import type {
  ContentTypeDefinition,
  ContentEntry,
  SupportedLocale,
} from '../../content-model/types.ts';
import type { DetailTemplateConfig } from '../../templates/types.ts';
import { isFieldVisible } from '../../content-model/visibility.ts';
import FieldRenderer from '../fields/FieldRenderer.astro';
import { withBase, resolveLocalizedValue } from '../../utils/url.ts';
import { t } from '../../i18n/utils.ts';
import { DEFAULT_LOCALE } from '../../i18n/types.ts';

interface Props {
  contentType: ContentTypeDefinition;
  entry: ContentEntry;
  detailTemplate?: DetailTemplateConfig;
  locale?: SupportedLocale;
  class?: string;
}

const {
  contentType,
  entry,
  detailTemplate,
  locale = DEFAULT_LOCALE,
  class: className = '',
} = Astro.props;

// Determine ordered list of field keys
const allFields = contentType.fields;
const fieldOrder = detailTemplate?.fieldOrder || allFields.map((f) => f.key);

// Filter fields by visibility in 'detail' context using configured template settings
const visibleFields = fieldOrder
  .map((key) => allFields.find((f) => f.key === key))
  .filter((field): field is NonNullable<typeof field> => {
    if (!field) return false;
    return isFieldVisible(contentType, entry, field.key, 'detail', detailTemplate?.templateSettings);
  });

const coverField = visibleFields.find((f) => f.type === 'image' || f.key === 'coverImage');
const titleField = visibleFields.find((f) => f.key === 'title' || f.type === 'text');
const dateField = visibleFields.find((f) => f.type === 'date');
const tagsField = visibleFields.find((f) => f.type === 'tags');
const otherFields = visibleFields.filter(
  (f) => f !== coverField && f !== titleField && f !== dateField && f !== tagsField
);

const backHref = locale === DEFAULT_LOCALE
  ? withBase(`/${contentType.slug}/index.html`)
  : withBase(`/${locale}/${contentType.slug}/index.html`);

const entryTitle = titleField ? resolveLocalizedValue(entry.fields[titleField.key], locale) : entry.slug;
const collectionName = resolveLocalizedValue(contentType.name, locale);
---

<div class={`container page-header ${className}`}>
  <a href={backHref} class="back-link">
    {t('ui.backTo', locale, { name: collectionName })}
  </a>

  <header style="margin-top: 1rem; margin-bottom: 2rem;">
    {titleField && (
      <h1 class="page-title" style="margin-bottom: 0.5rem;">
        {entryTitle}
      </h1>
    )}

    {dateField && entry.fields[dateField.key] && (
      <p class="page-count" style="margin-bottom: 1rem;">
        {t('ui.publishedOn', locale)} <FieldRenderer field={dateField} value={entry.fields[dateField.key]} locale={locale} />
      </p>
    )}

    {tagsField && entry.fields[tagsField.key] && (
      <div style="margin-top: 0.5rem;">
        <FieldRenderer field={tagsField} value={entry.fields[tagsField.key]} locale={locale} />
      </div>
    )}
  </header>

  {coverField && entry.fields[coverField.key] && (
    <div style="margin-bottom: 2rem; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--border); max-width: 720px; max-height: 400px; display: flex; align-items: center; justify-content: center; background: var(--surface);">
      <FieldRenderer
        field={coverField}
        value={entry.fields[coverField.key]}
        locale={locale}
        aspectRatio="auto"
        class="max-h-96 w-auto object-contain"
      />
    </div>
  )}

  <div class="detail-body" style="display: flex; flex-direction: column; gap: 1.5rem; line-height: 1.8;">
    {otherFields.map((field) => {
      const val = entry.fields[field.key];
      if (val === undefined || val === null) return null;
      const fieldName = resolveLocalizedValue(field.name, locale);

      return (
        <section class={`detail-field detail-field-${field.key}`}>
          {field.type !== 'textarea' && field.type !== 'richtext' && (
            <h2 class="section-label" style="margin-bottom: 0.5rem;">
              {fieldName}
            </h2>
          )}
          <div style="color: var(--text-2);">
            <FieldRenderer
              field={field}
              value={val}
              locale={locale}
              as={field.type === 'textarea' ? 'p' : 'div'}
            />
          </div>
        </section>
      );
    })}
  </div>
</div>
