# Firebase Web Configuration for portfolio-yosr-v2 (Spark Plan - Free)
# Obtain these values from Firebase Console -> Project Settings -> General -> Your apps -> Web app

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=portfolio-yosr-v2.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=portfolio-yosr-v2
VITE_FIREBASE_STORAGE_BUCKET=portfolio-yosr-v2.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id_here

# Mode: Set to 'true' to run in offline local simulated mode with mock persistence
# Useful when Firebase credentials are not yet configured or for offline development
VITE_USE_LOCAL_MOCK_STORAGE=false
