---
import { LOCALE_CONFIGS, DEFAULT_LOCALE, type SupportedLocale } from '../i18n/types.ts';
import { t } from '../i18n/utils.ts';
import { withBase } from '../utils/url.ts';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  locale?: SupportedLocale;
  currentPath?: string;
}

const {
  title = 'Portfolio — Yosr Meddah',
  description = 'Portfolio of Yosr Meddah — Software Engineering, Accessibility, Eco-design',
  locale = DEFAULT_LOCALE,
  currentPath = Astro.url.pathname,
} = Astro.props;

const localeConfig = LOCALE_CONFIGS[locale] || LOCALE_CONFIGS[DEFAULT_LOCALE];
const styleHref = withBase('/style.css');
const faviconNoir = withBase('/assets/logo-noir.png');
const faviconBlanc = withBase('/assets/logo-blanc.png');
---

<!DOCTYPE html>
<html lang={localeConfig.lang} dir={localeConfig.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Adaptive favicon: black logo in light mode, white logo in dark mode -->
    <link
      id="favicon"
      rel="icon"
      type="image/png"
      href={faviconNoir}
      data-light-href={faviconNoir}
      data-dark-href={faviconBlanc}
    />

    <!-- Google Fonts: Amiri, Instrument Serif, IBM Plex Sans, IBM Plex Sans Arabic -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Instrument+Serif:ital@0;1&family=IBM+Plex+Sans:wght@300;400;500&family=IBM+Plex+Sans+Arabic:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Devicon icons for technologies -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.15.1/devicon.min.css"
    />

    <!-- Original Portfolio Design System CSS -->
    <link rel="stylesheet" href={styleHref} />

    <!-- Anti-flash theme initialization + adaptive favicon -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var media = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null;

        function getStoredTheme() {
          try {
            var saved = localStorage.getItem('theme');
            return saved === 'light' || saved === 'dark' ? saved : null;
          } catch (err) {
            return null;
          }
        }

        function getSystemTheme() {
          return media && media.matches ? 'dark' : 'light';
        }

        function updateFavicon(theme) {
          var link = document.getElementById('favicon');
          if (!link) return;

          var href = theme === 'dark'
            ? link.getAttribute('data-dark-href')
            : link.getAttribute('data-light-href');
          if (href && link.getAttribute('href') !== href) {
            link.setAttribute('href', href);
          }
        }

        function applyTheme(theme) {
          root.dataset.theme = theme;
          updateFavicon(theme);
        }

        applyTheme(getStoredTheme() || getSystemTheme());

        // Keep the favicon in sync with the manual Light/Dark selector.
        new MutationObserver(function () {
          updateFavicon(root.dataset.theme === 'dark' ? 'dark' : 'light');
        }).observe(root, { attributes: true, attributeFilter: ['data-theme'] });

        // Follow the OS preference as long as the user has not chosen a theme.
        if (media) {
          var onSystemThemeChange = function (event) {
            if (!getStoredTheme()) {
              applyTheme(event.matches ? 'dark' : 'light');
            }
          };
          if (media.addEventListener) {
            media.addEventListener('change', onSystemThemeChange);
          } else if (media.addListener) {
            media.addListener(onSystemThemeChange);
          }
        }
      })();
    </script>
  </head>
  <body>
    <!-- Skip to main content accessible link -->
    <a class="skip-link" href="#main" id="skip-link">
      {t('nav.skipToContent', locale)}
    </a>

    <!-- Navbar -->
    <Navbar locale={locale} currentPath={currentPath} />

    <!-- Main Content Area -->
    <main id="main">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Reveal animation observer -->
    <script is:inline>
      function observe() {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('visible');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.1 });
        document.querySelectorAll('.reveal:not(.visible)').forEach((el) => io.observe(el));
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', observe);
      } else {
        observe();
      }
    </script>
  </body>
</html>
