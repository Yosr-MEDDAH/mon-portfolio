---
import { cmsLocalized, type GalleryEntryItem } from '../data/portfolio.ts';
import { withBase } from '../utils/url.ts';
import { t } from '../i18n/utils.ts';
import type { SupportedLocale } from '../i18n/types.ts';

interface Props {
  entries: GalleryEntryItem[];
  locale: SupportedLocale;
  maxImagesPerEntry?: number;
}

const { entries, locale, maxImagesPerEntry } = Astro.props;

const visibleEntries = entries
  .map((entry) => {
    const imgs = maxImagesPerEntry ? entry.images.slice(0, maxImagesPerEntry) : entry.images;
    return { ...entry, images: imgs };
  })
  .filter((entry) => entry.images.length > 0);

// Flatten all rendered images for continuous Lightbox navigation
let flatIndex = 0;
const renderedEntries = visibleEntries.map((entry) => {
  const title = cmsLocalized(entry.title, locale);
  const description = cmsLocalized(entry.description, locale);
  const images = entry.images.map((img) => {
    const src = img.url.startsWith('http://') || img.url.startsWith('https://') || img.url.startsWith('data:')
      ? img.url
      : withBase(`/${img.url.replace(/^\//, '')}`);
    const caption = cmsLocalized(img.caption, locale);
    const alt = cmsLocalized(img.alt, locale) || caption || title || 'Gallery image';
    const index = flatIndex++;
    return { src, caption, alt, index };
  });
  return { ...entry, title, description, images };
});
---

{renderedEntries.length > 0 && (
  <div class="gallery-entries" data-gallery-root>
    {renderedEntries.map((entry) => (
      <div class="gallery-entry">
        {(entry.title || entry.description) && (
          <div class="gallery-entry-header">
            {entry.title && <h3 class="gallery-entry-title">{entry.title}</h3>}
            {entry.description && <p class="gallery-entry-desc">{entry.description}</p>}
          </div>
        )}
        <div class="gallery-grid" role="list">
          {entry.images.map((img) => (
            <figure class="gallery-card reveal visible" role="listitem">
              <button
                type="button"
                class="gallery-trigger"
                data-gallery-index={img.index}
                data-gallery-src={img.src}
                data-gallery-alt={img.alt}
                data-gallery-caption={img.caption}
                aria-label={img.caption || img.alt}
              >
                <img
                  src={img.src}
                  alt={img.alt}
                  loading="lazy"
                  decoding="async"
                />
              </button>
              {img.caption && (
                <figcaption class="gallery-caption">{img.caption}</figcaption>
              )}
            </figure>
          ))}
        </div>
      </div>
    ))}

    <!-- Accessible Lightbox Modal -->
    <div
      id="gallery-lightbox"
      class="gallery-lightbox"
      role="dialog"
      aria-modal="true"
      aria-hidden="true"
      aria-label={t('page.gallery', locale)}
      hidden
    >
      <div class="gallery-lightbox-backdrop" data-lightbox-close></div>
      <div class="gallery-lightbox-dialog">
        <button
          type="button"
          class="gallery-lightbox-close"
          data-lightbox-close
          aria-label={t('gallery.close', locale)}
        >
          ✕
        </button>

        <button
          type="button"
          class="gallery-lightbox-nav gallery-lightbox-prev"
          data-lightbox-prev
          aria-label={t('gallery.prev', locale)}
        >
          {locale === 'ar' ? '›' : '‹'}
        </button>

        <figure class="gallery-lightbox-figure">
          <img id="gallery-lightbox-img" src="" alt="" />
          <figcaption id="gallery-lightbox-caption" class="gallery-lightbox-caption"></figcaption>
        </figure>

        <button
          type="button"
          class="gallery-lightbox-nav gallery-lightbox-next"
          data-lightbox-next
          aria-label={t('gallery.next', locale)}
        >
          {locale === 'ar' ? '‹' : '›'}
        </button>

        <div id="gallery-lightbox-counter" class="gallery-lightbox-counter"></div>
      </div>
    </div>
  </div>
)}

<script is:inline>
  (function () {
    const lightbox = document.getElementById('gallery-lightbox');
    if (!lightbox || lightbox.dataset.bound === 'true') return;
    lightbox.dataset.bound = 'true';

    const triggers = Array.from(document.querySelectorAll('.gallery-trigger[data-gallery-index]'));
    if (triggers.length === 0) return;

    const items = triggers.map((el) => ({
      src: el.getAttribute('data-gallery-src') || '',
      alt: el.getAttribute('data-gallery-alt') || '',
      caption: el.getAttribute('data-gallery-caption') || '',
      trigger: el,
    }));

    const imgEl = document.getElementById('gallery-lightbox-img');
    const captionEl = document.getElementById('gallery-lightbox-caption');
    const counterEl = document.getElementById('gallery-lightbox-counter');
    const closeBtn = lightbox.querySelector('.gallery-lightbox-close');
    const prevBtn = lightbox.querySelector('[data-lightbox-prev]');
    const nextBtn = lightbox.querySelector('[data-lightbox-next]');

    let currentIndex = 0;
    let lastFocused = null;

    function render(idx) {
      currentIndex = (idx + items.length) % items.length;
      const item = items[currentIndex];
      if (imgEl) {
        imgEl.src = item.src;
        imgEl.alt = item.alt;
      }
      if (captionEl) {
        captionEl.textContent = item.caption;
        captionEl.style.display = item.caption ? 'block' : 'none';
      }
      if (counterEl) {
        counterEl.textContent = `${currentIndex + 1} / ${items.length}`;
      }
      const showNav = items.length > 1;
      if (prevBtn) prevBtn.style.display = showNav ? 'flex' : 'none';
      if (nextBtn) nextBtn.style.display = showNav ? 'flex' : 'none';
    }

    function open(idx, triggerEl) {
      lastFocused = triggerEl || document.activeElement;
      render(idx);
      lightbox.hidden = false;
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      if (closeBtn) closeBtn.focus();
    }

    function close() {
      lightbox.hidden = true;
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (lastFocused && typeof lastFocused.focus === 'function') {
        lastFocused.focus();
      }
    }

    triggers.forEach((el, idx) => {
      el.addEventListener('click', () => open(idx, el));
    });

    lightbox.querySelectorAll('[data-lightbox-close]').forEach((el) => {
      el.addEventListener('click', close);
    });

    if (prevBtn) prevBtn.addEventListener('click', () => render(currentIndex - 1));
    if (nextBtn) nextBtn.addEventListener('click', () => render(currentIndex + 1));

    document.addEventListener('keydown', (e) => {
      if (lightbox.hidden) return;
      const isRtl = document.documentElement.dir === 'rtl';
      if (e.key === 'Escape') {
        close();
      } else if (e.key === 'ArrowLeft') {
        render(currentIndex + (isRtl ? 1 : -1));
      } else if (e.key === 'ArrowRight') {
        render(currentIndex + (isRtl ? -1 : 1));
      }
    });
  })();
</script>
